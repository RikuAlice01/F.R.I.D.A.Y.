<?xml version="1.0" encoding="utf-8"?>
<!-- the pairing (device id, PC address, pinned certificate) never leaves the phone in a cloud backup -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
